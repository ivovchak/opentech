#!/usr/bin/env bash
# Claude Code billed to the Anthropic API key (pay per token) instead of the subscription
# The key is read from $OT_HOME/anthropic-api-key (git-ignored) or from OT_ANTHROPIC_API_KEY
OT_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KEY_FILE="$OT_HOME/anthropic-api-key"

KEY="${OT_ANTHROPIC_API_KEY:-}"
if [ -z "$KEY" ] && [ -f "$KEY_FILE" ]; then
  KEY="$(tr -d '[:space:]' < "$KEY_FILE")"
fi
if [ -z "$KEY" ]; then
  echo "API key not found. Create it with:" >&2
  echo "  printf '%s' 'sk-ant-...' > \"$KEY_FILE\" && chmod 600 \"$KEY_FILE\"" >&2
  exit 1
fi

export CLAUDE_CONFIG_DIR="$OT_HOME/claude-api"
export ANTHROPIC_API_KEY="$KEY"
export OT_HOME
# Yellow "OpenTech API" badge in the status line (see bin/ot-statusline)
exec claude --settings '{"statusLine":{"type":"command","command":"\"$OT_HOME/bin/ot-statusline\""}}' "$@"
